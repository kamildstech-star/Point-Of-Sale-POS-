APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Phase 1 SPA: exact origins, plus host/ports without schemes for Sanctum.
SPA_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=127.0.0.1:5173,localhost:5173,127.0.0.1:8000
# Set true under HTTPS staging/production; keep the existing APP_KEY.
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Phase 7 SaaS billing. Supply test-mode credentials privately; never change APP_KEY.
STRIPE_BILLING_ENABLED=false
STRIPE_LIVE_ENABLED=false
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd
FRONTEND_URL=http://127.0.0.1:5173
BILLING_QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=180
BILLING_LEGACY_ACCESS=true
BILLING_GRACE_DAYS=7
# Local encrypted backup implementation requires Windows DPAPI and this user's key.
OPERATIONS_SCHEDULED_BACKUPS=false

# Dashboard rollout. Keep D5/D6 off until the selected pilot is reviewed.
DASHBOARD_API_ENABLED=true
DASHBOARD_CACHE_SECONDS=30
DASHBOARD_SPECIALIST_ENABLED=false
# Comma-separated tenant IDs; empty means all tenants once specialists are enabled.
DASHBOARD_PILOT_TENANT_IDS=
# Platform access also requires an explicitly audited dashboard.platform.view grant.
DASHBOARD_PLATFORM_ENABLED=false

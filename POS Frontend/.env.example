# Leave empty when using the dev proxy or a same-origin staging reverse proxy.
VITE_API_URL=
# Laravel development server used by Vite's /api and /sanctum proxy.
POS_API_TARGET=http://127.0.0.1:8000

# Set false and rebuild to restore the welcome overview. Keep D2 API access enforcement enabled.
VITE_OWNER_ADMIN_DASHBOARD_ENABLED=true

# Set false and rebuild to keep cashier/manager profiles on the welcome overview.
VITE_STAFF_DASHBOARD_ENABLED=true
